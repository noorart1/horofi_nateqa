# Always HTTPS: passwords and the session cookie must not travel in clear text.
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Text is compressed. LiteSpeed (the host) already sends br by itself; this is for a plain Apache host.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# css and js are linked with ?v=<version> (or a version in the name), and the fonts never change their file:
# a new file gets a new address, so a browser may keep these for a year without asking again.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the games' pictures (img/game/NN.webp, NNp, NNc): game.js links them with ?v=<version>, the same rule.
  # (other pictures go through img.php, which sends its own headers; no page links an img/*.webp directly)
  <FilesMatch "^\d\d[pc]?\.webp$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # the living banner's layers (img/banner/*.png, cut by tools/banner_layers.py): index.php links them with ?v=<version>
  <FilesMatch "^(hand|forearm|note|clef|marker)\.png$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
